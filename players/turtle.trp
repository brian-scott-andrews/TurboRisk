{
Program: Turtle
Author: Brian S. Andrews

AI disclaimer: This script was created with AI assistance. Its strategy is
heuristic, and actual behavior may differ from the description below.

Description:
Prioritizes survival and a small, defensible frontier. It reinforces the most
pressured position and attacks only with a decisive numerical advantage or
when a single weak territory offers a low-risk card capture.
}

procedure Assignment(var ToTerritory: integer);
var T, B, Score, Best: integer;
begin
  ToTerritory:=0; Best:=-1;
  for T:=1 to 42 do if TOwner(T)=0 then begin
    Score:=0;
    for B:=1 to TBordersCount(T) do if TOwner(TBorder(T,B))=PMe then Score:=Score+2;
    Score:=Score-TBordersCount(T);
    if Score>Best then begin Best:=Score; ToTerritory:=T end;
  end;
end;

procedure Placement(var ToTerritory: integer);
var T, Score, Best: integer;
begin
  ToTerritory:=0; Best:=-1;
  for T:=1 to 42 do if TIsMine(T) and TIsFront(T) then begin
    Score:=TPressure(T)*10-TArmies(T)*3;
    if Score>Best then begin Best:=Score; ToTerritory:=T end;
  end;
  if ToTerritory=0 then for T:=1 to 42 do if TIsMine(T) then begin ToTerritory:=T; break end;
end;

procedure Attack(var FromTerritory, ToTerritory: integer);
var T, F, E: integer; Ratio, Best: double;
begin
  FromTerritory:=0; ToTerritory:=0; Best:=2.75;
  for T:=1 to 42 do if TIsMine(T) and (TArmies(T)>1) then
    for F:=1 to TFrontsCount(T) do begin
      E:=TFront(T,F); Ratio:=double(TArmies(T)-1)/TArmies(E);
      if (Ratio>=2.75) and (Ratio>Best) then begin
        Best:=Ratio; FromTerritory:=T; ToTerritory:=E;
      end;
    end;
end;

procedure Occupation(FromTerritory, ToTerritory: integer; var Armies: integer);
begin
  Armies:=0;
  if not TIsFront(FromTerritory) then Armies:=TArmies(FromTerritory)-1;
end;

procedure Fortification(var FromTerritory, ToTerritory, Armies: integer);
var T, Dest, Best: integer;
begin
  FromTerritory:=0; ToTerritory:=0; Armies:=0; Best:=1;
  for T:=1 to 42 do if TIsMine(T) and not TIsFront(T) and (TArmies(T)>Best) then begin
    Dest:=TPathToFront(T);
    if Dest>0 then begin Best:=TArmies(T); FromTerritory:=T; ToTerritory:=Dest; Armies:=Best-1 end;
  end;
end;

begin
end.
