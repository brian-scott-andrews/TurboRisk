{
Program: Comeback
Author: Brian S. Andrews

AI disclaimer: This script was created with AI assistance. Its strategy is
heuristic, and actual behavior may differ from the description below.

Description:
When behind in total army strength, it seeks weak opponents and low-risk
territories while avoiding broad fronts. As its position improves, it raises
its attack threshold and invests in continent bonuses.
}

procedure Assignment(var ToTerritory: integer);
var T, C, PT, PA, ET, EA, Best: integer;
begin
  ToTerritory:=0; Best:=-1;
  for T:=1 to 42 do if TOwner(T)=0 then begin
    C:=TContinent(T); CAnalysis(C,PT,PA,ET,EA);
    if ET*10-PT>Best then begin Best:=ET*10-PT; ToTerritory:=T end;
  end;
end;

procedure Placement(var ToTerritory: integer);
var T, F, E, OwnArmies, EnemyArmies, Score, Best: integer;
begin
  OwnArmies:=PArmiesCount(PMe); EnemyArmies:=0;
  for T:=1 to 10 do if PAlive(T) and (T<>PMe) then EnemyArmies:=EnemyArmies+PArmiesCount(T);
  ToTerritory:=0; Best:=-100000;
  for T:=1 to 42 do if TIsMine(T) and TIsFront(T) then begin
    Score:=TPressure(T)-TArmies(T)*2;
    for F:=1 to TFrontsCount(T) do begin E:=TFront(T,F); if TArmies(E)<=2 then Score:=Score+5 end;
    if OwnArmies<EnemyArmies then Score:=Score+TFrontsCount(T)*2;
    if Score>Best then begin Best:=Score; ToTerritory:=T end;
  end;
  if ToTerritory=0 then for T:=1 to 42 do if TIsMine(T) then begin ToTerritory:=T; break end;
end;

procedure Attack(var FromTerritory, ToTerritory: integer);
var T, F, E, P, Target, Weakest, OwnArmies, EnemyArmies, Pass: integer;
  Ratio, Best: double;
begin
  OwnArmies:=PArmiesCount(PMe); EnemyArmies:=0; Weakest:=100000; Target:=0;
  for P:=1 to 10 do if PAlive(P) and (P<>PMe) then begin
    EnemyArmies:=EnemyArmies+PArmiesCount(P);
    if (Target=0) or (PArmiesCount(P)<Weakest) then begin
      Weakest:=PArmiesCount(P);
      Target:=P;
    end;
  end;
  FromTerritory:=0; ToTerritory:=0;
  if OwnArmies<EnemyArmies then begin
    for Pass:=1 to 2 do begin
      if Pass=1 then Best:=1.10 else Best:=1.40;
      for T:=1 to 42 do if TIsMine(T) and (TArmies(T)>1) then
        for F:=1 to TFrontsCount(T) do begin
          E:=TFront(T,F); Ratio:=double(TArmies(T)-1)/TArmies(E);
          if (Pass=1) and (TOwner(E)=Target) and (Ratio>=Best) then begin
            Best:=Ratio; FromTerritory:=T; ToTerritory:=E;
          end
          else if (Pass=2) and (Ratio>=Best) then begin
            Best:=Ratio; FromTerritory:=T; ToTerritory:=E;
          end;
        end;
      if FromTerritory>0 then break;
    end;
  end
  else begin
    Best:=1.75;
    for T:=1 to 42 do if TIsMine(T) and (TArmies(T)>1) then
      for F:=1 to TFrontsCount(T) do begin
        E:=TFront(T,F); Ratio:=double(TArmies(T)-1)/TArmies(E);
        if Ratio>=Best then begin Best:=Ratio; FromTerritory:=T; ToTerritory:=E end;
      end;
  end;
end;

procedure Occupation(FromTerritory, ToTerritory: integer; var Armies: integer);
begin
  Armies:=0;
  if not TIsFront(FromTerritory) then Armies:=TArmies(FromTerritory)-1
  else if TIsFront(ToTerritory) then
    Armies:=(TArmies(FromTerritory)-TArmies(ToTerritory)) div 2;
end;

procedure Fortification(var FromTerritory, ToTerritory, Armies: integer);
var T, Dest, Best: integer;
begin
  FromTerritory:=0; ToTerritory:=0; Armies:=0; Best:=1;
  for T:=1 to 42 do if TIsMine(T) and not TIsFront(T) and (TArmies(T)>Best) then begin
    Dest:=TPathToFront(T);
    if Dest>0 then begin Best:=TArmies(T); FromTerritory:=T; ToTerritory:=Dest; Armies:=Best-1 end;
  end;
end;

begin
end.
