{
Program: Shy2

Author:  Julio Couce Molina (jcm790@hotmail.com)

Description: This is the same as Shy, except that it doesn't have a
preference for South America. In general, this one is weaker than Shy, but
some people might not want to play against an opponent that always begins
at the same place.
}
(*

Assigment: It selects a territory randomly.

Placement: Tries to avoid having frontier territories with less than 25
armies, beginning with those frontier territories with less armies. If
all frontier territories have at least 25 armies, it selects the territory
with more armies.

Attack: It only attacks with a 2 to 1 ratio or better. It prefers to attack
territories in the same continent until it conquers that continent, but it
can attack territories in other countries if that other continent is
controlled by one player or if the PlayesArmies/EnemyArmies ratio is very
good.

Occupation: If From and To territories are frontiers, half the armies go
to each territory. If only one of them is frontier, all armies (except one)
go to that territory. If none of them is frontier, all armies (except one)
go to To territory.

Fortification: Selects non-frontier territory with more armies, and moves
them to a neighbouring frontier territory. If there are not neighbouring
frontier territories, it moves the armies to a random neighbouring
territory.

Thanks: Thanks to Mario Ferrari, for creating this wonderful game
(Turborisk) and making it freeware. I especially like that you can program
your own artificial intelligence. It's fun, and that way you can't complain
about how stupid the AI is, because, if you think that, why don't you
program your own?


*)




procedure Assignment(var ToTerritory: integer);
var
  T,VarAuxi: integer;
begin
  // Choose a random unoccupied territory
  ToTerritory:=0;
  T:=trunc(URandom(42)+1);
  VarAuxi:=0;
  repeat
    if TOwner(T)=0 then
      ToTerritory:=T;
    T:=T+1;
    if (T>42) and (VarAuxi=0) then 
    begin
       T:=1;
       VarAuxi:=1;
    end;
  until (ToTerritory>0) or (T>42);
end;




procedure Placement(var ToTerritory: integer);
var
  Contador,Auxiliar,TInicial,T,VarAuxi,MaxArmies,FCount,F: integer;
begin
  // Place armies on a frontier territory with fewer than 25 armies,
  // choosing the one closest to 25; otherwise use the territory with the most armies.

  // Find a frontier territory with fewer than 25 armies
  ToTerritory:=0;
  MaxArmies:=100;
  T:=trunc(URandom(42)+1);
  TInicial:=T;
  VarAuxi:=0;
  repeat
    if (TIsFront(T)) and (TArmies(T)<MaxArmies) and (TArmies(T)<25) then
    begin
      ToTerritory:=T;
      MaxArmies:=TArmies(T);
    end;
    T:=T+1;
    if (T>42) and (VarAuxi=0) then 
    begin
       T:=1;
       VarAuxi:=1;
    end;
  until (VarAuxi=1) and (T>=TInicial);

  Auxiliar:=0;
  if (ToTerritory<>0) then begin
    if (TArmies(ToTerritory)=1) then begin
      FCount:=TBordersCount(ToTerritory);
      for F:=1 to FCount do begin
        If TIsMine(TBorder(ToTerritory,F)) then Auxiliar:=1;
      end;
        if (Auxiliar=0) then ToTerritory:=0;
    end;
  end;


  // If only one territory has more than one army, place armies there
  Contador:=0;
  for T:=1 to 42 do begin
    if (TIsMine(T)) and (TArmies(T)>1) then Contador:=Contador+1;
  end;
  if (Contador<2) then ToTerritory:=0;



  // If none is found, use the territory with the most armies
  if (ToTerritory=0) then begin
    MaxArmies:=0;
    T:=trunc(URandom(42)+1);
    TInicial:=T;
    VarAuxi:=0;
    repeat
      if (TIsMine(T)) and (TArmies(T)>MaxArmies) then
      begin
        ToTerritory:=T;
        MaxArmies:=TArmies(T);
      end;
      T:=T+1;
      if (T>42) and (VarAuxi=0) then 
      begin
         T:=1;
         VarAuxi:=1;
      end;
    until (VarAuxi=1) and (T>=TInicial);
  end;


  // Disable all-out attack mode
  UBufferSet(1,0);
  UBufferSet(2,0);
end;






procedure Attack(var FromTerritory, ToTerritory: integer);
var
  Completo,T2,F,FCount,T,ET,EA: integer;
  MejorOpcion,temp: double;
begin
  // Attack the weakest neighboring territory from a territory with more than 25 armies,
  // provided the force ratio is at least 2 to 1. Do not enter new continents until
  // finishing the ones already entered.

  FromTerritory:=0;
  ToTerritory:=0;

  // If an all-out attack to conquer a territory is already in progress, continue it
  if (UBufferGet(1)<>0) and (TArmies(trunc(UBufferGet(1)))>1) then begin
    FromTerritory:=trunc(UBufferGet(1));
    ToTerritory:=trunc(UBufferGet(2));
  end else begin
    // Otherwise, find the best attack among our territories
    // (we need more than 25 armies and a force ratio of at least 2 to 1).
    // Do not enter another continent until finishing those already in progress.
    MejorOpcion:=2;
    Completo:=1;
    for T:=1 to 42 do begin
      if (COwner(TContinent(T))=0) and (TIsMine(T)) then Completo:=0;
    end;
    
    for T:=1 to 42 do begin
      if (TIsFront(T)) then begin
        FCount:=TFrontsCount(T);
        for F:=1 to FCount do begin
          T2:=TFront(T,F);
          temp:=TArmies(T)/TArmies(T2);
          if (temp>9) or ((TArmies(T)>=25) or (FCount=1)) and (temp>MejorOpcion) and ((TContinent(T)=TContinent(T2)) or (Completo=1) or ((COwner(TContinent(T2))<>0) and (COwner(TContinent(T2))<>PMe)))
          then begin
            FromTerritory:=T;
            ToTerritory:=T2;
            UBufferSet(1,T);
            UBufferSet(2,T2);
            MejorOpcion:=TArmies(T)/TArmies(T2);
          end;
        end;
      end;
    end;
  end;  
end;






procedure Occupation(FromTerritory, ToTerritory: integer; var Armies: integer);
var
  FromIsFront, ToIsFront: boolean;
begin
  // Typically split armies evenly when both territories are fronts;
  // otherwise, keep them all at the front.

  FromIsFront := TIsFront(FromTerritory);
  ToIsFront := TIsFront(ToTerritory);
  Armies:=0;

  // If both territories are fronts
  if  FromIsFront and ToIsFront then begin
    // Split the armies evenly
    Armies:=(TArmies(FromTerritory)-TArmies(ToTerritory)) div 2;

  // If the source territory is a front
  end else if FromisFront then begin
    // Keep all armies here, so no movement is needed

  // In other cases
  end else begin
    // Move all armies to the conquered territory except one
    Armies:=TArmies(FromTerritory)-1;
  end;
  // Disable all-out attack mode
  UBufferSet(1,0);
  UBufferSet(2,0);
end;




procedure Fortification(var FromTerritory, ToTerritory, Armies: integer);
var
  T,B,MaxArmy: integer;
begin
  // Move armies from non-front territories to the front
  //

  FromTerritory:=0;
  ToTerritory:=0;
  Armies:=0;

  // Find the largest army on a non-front territory
  MaxArmy := 1;
  for T:=1 to 42 do begin
    if TIsMine(T) and not TIsFront(T) then begin  // My territory, not on the front
      if TArmies(T)>MaxArmy then begin
        MaxArmy := TArmies(T);
        FromTerritory := T;
      end;
    end;
  end;
  // If there are armies to move...
  if FromTerritory>0 then begin
    // Check whether they can be moved to the front
    for B:=1 to TBordersCount(FromTerritory) do begin
      if ToTerritory=0 then begin
        T:=TBorder(FromTerritory,B);
        if TIsMine(T) and TIsFront(T) then begin
          ToTerritory:=T;
        end;
      end;
    end;
    // Otherwise, move them to the first neighboring territory
    if ToTerritory=0 then begin
      repeat
        B:=trunc(1+URandom(TBordersCount(FromTerritory)));
        T:=TBorder(FromTerritory,B);
        if TIsMine(T) then begin
          ToTerritory:=T;
        end;
      until (ToTerritory>0);
    end;
    // Move all armies except one
    if ToTerritory>0 then begin
      Armies:=TArmies(FromTerritory)-1;
    end;
  end;
end;

begin
end.